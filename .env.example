OLLAMA_BASE_URL=http://localhost:11434

POSTGRES_DB=cdq_assistant
POSTGRES_USER=cdq
POSTGRES_PASSWORD=cdq_secret

# REST Countries API v5
# Get your free key at: https://restcountries.com
# NOTE: rc_live_demo provides sample responses for API shape testing ONLY.
#       It must NOT be used as a runtime key — it returns fake data.
REST_COUNTRIES_BASE_URL=https://api.restcountries.com
REST_COUNTRIES_API_KEY=your_real_key_here

# WeatherAPI.com (free tier)
# Sign up at: https://www.weatherapi.com/signup.aspx
WEATHER_API_KEY=your_weatherapi_key_here

WEATHER_MCP_PATH=./external/mcp-weather

# RAG similarity threshold — tune after Phase 4 with real corpus
RAG_SIMILARITY_THRESHOLD=0.5
